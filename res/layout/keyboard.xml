<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:hardwareAccelerated="false" android:orientation="vertical" android:background="?attr/colorKeyboard">
  <LinearLayout android:id="@+id/ironkeys_encrypt_bar" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:visibility="gone" android:paddingStart="8dp" android:paddingEnd="8dp" android:paddingTop="6dp" android:paddingBottom="2dp">
    <EditText android:id="@+id/ironkeys_encrypt_text" android:layout_width="0dp" android:layout_height="40dp" android:layout_weight="1" android:singleLine="true" android:maxLength="32" android:imeOptions="actionDone" android:inputType="textCapSentences|textNoSuggestions" android:hint="@string/ironkeys_encrypt_message_hint" android:background="@drawable/suggestions_item_background" android:textColor="?attr/colorLabel" android:textColorHint="?attr/colorSubLabel" android:paddingStart="10dp" android:paddingEnd="10dp"/>
    <TextView android:id="@+id/ironkeys_decrypt_result_text" android:layout_width="0dp" android:layout_height="40dp" android:layout_weight="1" android:singleLine="true" android:ellipsize="end" android:gravity="center_vertical" android:hint="@string/ironkeys_decrypt_result_hint" android:background="@drawable/suggestions_item_background" android:textColor="?attr/colorLabel" android:textColorHint="?attr/colorSubLabel" android:paddingStart="10dp" android:paddingEnd="10dp" android:visibility="gone"/>
    <Button android:id="@+id/ironkeys_encrypt_keys_button" android:layout_width="72dp" android:layout_height="40dp" android:layout_marginStart="8dp" android:text="@string/ironkeys_encrypt_keys_button" android:contentDescription="@string/ironkeys_encrypt_keys_button" android:textColor="?attr/colorLabel" android:background="@drawable/suggestions_item_background"/>
    <ProgressBar android:id="@+id/ironkeys_encrypt_progress" android:layout_width="72dp" android:layout_height="40dp" android:layout_marginStart="8dp" android:indeterminate="true" android:visibility="gone"/>
  </LinearLayout>
  <juloo.keyboard2.suggestions.CandidatesView android:id="@+id/candidates_view" style="@style/candidates_view">
    <TextView android:id="@+id/candidates_emoji" style="@style/candidates_emoji"/>
    <TextView android:id="@+id/candidates_left" style="@style/candidates_item"/>
    <TextView android:id="@+id/candidates_middle" style="@style/candidates_item"/>
    <TextView android:id="@+id/candidates_right" style="@style/candidates_item"/>
  </juloo.keyboard2.suggestions.CandidatesView>
  <FrameLayout android:layout_width="match_parent" android:layout_height="wrap_content">
    <juloo.keyboard2.Keyboard2View android:id="@+id/keyboard_view" android:layout_width="match_parent" android:layout_height="wrap_content"/>
    <LinearLayout android:id="@+id/ironkeys_decrypt_pane" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="?attr/colorKeyboard" android:paddingStart="8dp" android:paddingEnd="8dp" android:paddingTop="8dp" android:paddingBottom="6dp" android:visibility="gone">
      <EditText android:id="@+id/ironkeys_decrypt_text" android:layout_width="match_parent" android:layout_height="@dimen/ironkeys_decrypt_text_height" android:gravity="top|start" android:inputType="textMultiLine|textNoSuggestions" android:imeOptions="flagNoExtractUi" android:hint="@string/ironkeys_decrypt_ciphertext_hint" android:background="@drawable/suggestions_item_background" android:textColor="?attr/colorLabel" android:textColorHint="?attr/colorSubLabel" android:paddingStart="10dp" android:paddingEnd="10dp" android:paddingTop="10dp" android:paddingBottom="10dp"/>
      <LinearLayout android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="8dp" android:orientation="horizontal">
        <Button android:id="@+id/ironkeys_decrypt_back_button" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="@string/ironkeys_decrypt_back_button" android:contentDescription="@string/ironkeys_decrypt_back_button" android:textColor="?attr/colorLabel" android:background="@drawable/suggestions_item_background"/>
        <Button android:id="@+id/ironkeys_decrypt_submit_button" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_marginStart="8dp" android:text="@string/ironkeys_decrypt_button" android:contentDescription="@string/ironkeys_decrypt_button" android:textColor="?attr/colorLabel" android:background="@drawable/suggestions_item_background"/>
        <ProgressBar android:id="@+id/ironkeys_decrypt_progress" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_marginStart="8dp" android:indeterminate="true" android:visibility="gone"/>
      </LinearLayout>
    </LinearLayout>
  </FrameLayout>
</LinearLayout>
